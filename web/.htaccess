# Opera+ Funding only: prevent stale HTML/JS/JSON on mobile browsers.
# The versioned asset links also change on each publisher release.
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|app\.js|styles\.css|opportunities\.json|scan-status\.json)$">
    Header always set Cache-Control "no-store, no-cache, max-age=0, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>
</IfModule>
